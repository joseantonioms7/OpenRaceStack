# ApexPathAI Environment Configuration Example

# Project Information
PROJECT_NAME="ApexPathAI AV Validation Platform"
VERSION="2.0.0"

# Database Configuration (PostgreSQL in production, SQLite in local dev)
POSTGRES_USER=apexpath
POSTGRES_PASSWORD=apexpath_secret
POSTGRES_DB=apexpath_db
DATABASE_URL=postgresql+asyncpg://apexpath:apexpath_secret@localhost:5432/apexpath_db

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# Proving Ground Settings
DEFAULT_CIRCUIT=Monza
DEFAULT_VEHICLE_ID=apex-f1tenth-01
SIMULATION_DT=0.05
TELEMETRY_BROADCAST_HZ=20.0

# Optional Mapbox Vector Tile Access Token (Fallback to high-precision Canvas rendering if unset)
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
